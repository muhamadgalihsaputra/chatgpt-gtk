#!/usr/bin/env python3
import sys
import os

# Filter out literal desktop placeholders if passed erroneously
filtered_args = [arg for arg in sys.argv if arg not in ("%u", "%U")]
if not filtered_args:
    filtered_args = [sys.argv[0]]

# Add repo root to sys.path if run directly from repository
repo_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if repo_dir not in sys.path:
    sys.path.insert(0, repo_dir)

from chatgpt_gtk.app import ChatGPTApp

if __name__ == "__main__":
    app = ChatGPTApp()
    sys.exit(app.run(filtered_args))
